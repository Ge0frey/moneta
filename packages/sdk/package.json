{
  "name": "@moneta/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Moneta TypeScript SDK: ABIs, address book, exact protocol math, action codec, error decoding, tx pipeline, indexer client",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./abis": "./src/generated/abis.ts",
    "./abi-json/*": "./abi-json/*"
  },
  "scripts": {
    "generate": "wagmi generate && tsx scripts/sync-deployments.ts",
    "vectors": "cd ../contracts && forge test --match-contract VectorsTest -q",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@moneta/config": "workspace:*",
    "@types/node": "24.19.1",
    "@wagmi/cli": "2.10.0",
    "esbuild": "~0.27.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
