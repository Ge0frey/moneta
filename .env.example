# ─────────────────────────────────────────────────────────────────────────────
# Moneta environment template. Copy to `.env` (never commit `.env`).
# Local development works with the defaults below — no secrets required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contracts (packages/contracts) ───────────────────────────────────────────
# Local anvil RPC (pnpm dev:chain)
LOCAL_RPC_URL=http://127.0.0.1:8545
# Monad testnet RPC (public; swap for a keyed provider if rate-limited)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Foundry encrypted keystore account name used for testnet deploys
# (create with: cast wallet import moneta-deployer --interactive)
DEPLOYER_ACCOUNT=moneta-deployer
# Protocol admin (Safe) and fee recipient — default to the deployer if unset
PROTOCOL_SAFE=
FEE_RECIPIENT=
# Monadscan (Etherscan-compatible) API key — only needed for Monadscan verification
MONADSCAN_API_KEY=
# Quote asset per network (Circle USDC on Monad testnet; MonetaUSDC is auto-deployed locally)
QUOTE_TOKEN_TESTNET=0x534b2f3A21130d7a60830c2Df862319e593943A3

# ── Web app (apps/web) — all public by design ────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=31337
# Comma-separated RPC list, tried in order (keyed provider first in production)
NEXT_PUBLIC_RPC_URLS=http://127.0.0.1:8545
NEXT_PUBLIC_INDEXER_URL=http://localhost:8080/v1/graphql
# Reown/WalletConnect project id (injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ── Indexer (apps/indexer) ───────────────────────────────────────────────────
# Envio HyperSync API token (https://envio.dev/app/api-tokens) — testnet only
ENVIO_API_TOKEN=

# ── Bots (apps/bots) ─────────────────────────────────────────────────────────
BOTS_NETWORK=local
RPC_URL=http://127.0.0.1:8545
WS_URL=
INDEXER_URL=http://localhost:8080/v1/graphql
# Leave empty locally (anvil's well-known dev keys are used). For testnet, set KEEPER_KEY / TRADER_MNEMONIC in
# your platform's secret store (Railway/Fly), not in this file. NEVER put mainnet keys anywhere here.
KEEPER_KEY=
TRADER_MNEMONIC=
ALERT_WEBHOOK_URL=
SENTRY_DSN=
